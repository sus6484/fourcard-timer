rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userDoc().role == 'admin';
    }

    function isBranch(branchId) {
      return signedIn() && userDoc().role == 'branch' && userDoc().branchId == branchId;
    }

    match /presets/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sessions/{branchId} {
      allow read: if isAdmin() || isBranch(branchId);
      allow write: if isAdmin() || isBranch(branchId);
    }

    // 기기별 Absolute Time 보정용 (serverTimestamp 왕복 측정)
    // 문서 ID: {uid}_{deviceId} — 멀티비전 동시 sync 충돌 방지
    match /clockSync/{docId} {
      allow read, write: if signedIn();
    }
  }
}
